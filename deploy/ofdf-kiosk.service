# 제어함 10인치 터치패널 — 부팅하면 화면이 바로 뜬다
#
#   sudo cp deploy/ofdf-kiosk.service /etc/systemd/system/
#   sudo systemctl enable --now ofdf-kiosk
#
# ※ 이 유닛은 실제 라즈베리파이에서 검증하지 않았다. 패널을 연결한 뒤
#   한 번 돌려보고 조정해야 한다. 특히 Raspberry Pi OS Bookworm 은
#   기본이 Wayland(labwc) 라 화면 꺼짐 설정 경로가 X11 과 다르다.
#
# 농가가 화면을 끄거나 창을 닫을 수단이 없어야 한다. 전체화면 고정이고,
# 죽으면 되살아난다. 마지막으로 본 화면(농가/운영자)은 localStorage 에
# 남으므로 시크릿 모드로 띄우지 않는다.

[Unit]
Description=노지 대파 재해위험 현장 화면 키오스크
After=graphical.target ofdf-dashboard.service
Wants=ofdf-dashboard.service

[Service]
Type=simple
User=ofdf
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/1000

# 정전으로 꺼지면 다음 부팅 때 '페이지를 복원할까요?' 가 뜬다.
# 아무도 누르지 않으므로 그 표시를 미리 지운다.
ExecStartPre=-/bin/sh -c "sed -i 's/\"exited_cleanly\":false/\"exited_cleanly\":true/; s/\"exit_type\":\"[^\"]*\"/\"exit_type\":\"Normal\"/' /home/ofdf/.config/chromium/Default/Preferences"

ExecStart=/usr/bin/chromium-browser \
    --kiosk \
    --app=http://127.0.0.1:8080/ \
    --noerrdialogs \
    --disable-infobars \
    --disable-session-crashed-bubble \
    --disable-features=TranslateUI \
    --no-first-run \
    --password-store=basic \
    --check-for-update-interval=31536000

Restart=always
RestartSec=10

[Install]
WantedBy=graphical.target
