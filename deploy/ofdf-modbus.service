# RS-485 수질 센서 수집 (USB-RS485 → MODBUS-RTU → 수집 파일) — 있을 때만
#
#   sudo cp deploy/ofdf-modbus.service /etc/systemd/system/
#   sudo systemctl enable --now ofdf-modbus
#
# 변환기가 안 꽂혀 있으면 시작하지 않는다(ConditionPathExists). 없는 장비를
# 매 주기 읽으려다 오류를 쌓거나 재시작 루프를 돌면 안 된다. 꽂으면 다음
# 부팅이나 `systemctl start ofdf-modbus` 에서 돈다.

[Unit]
Description=노지 대파 관수원수 수질 수집 (RS-485)
After=multi-user.target
ConditionPathExists=/dev/ttyUSB0

[Service]
Type=simple
User=ofdf
SupplementaryGroups=dialout
WorkingDirectory=/opt/ofdf
Environment=PYTHONUNBUFFERED=1
ExecStart=/opt/ofdf/venv/bin/python scripts/modbus_bridge.py \
          --devices configs/devices.yaml --out data/field --capture data/field/capture
Restart=on-failure
RestartSec=10

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/opt/ofdf/data
DeviceAllow=/dev/ttyUSB0 rw
DeviceAllow=/dev/serial0 rw
MemoryMax=128M
Nice=5

[Install]
WantedBy=multi-user.target
